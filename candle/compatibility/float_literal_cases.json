{
  "schema_version": 1,
  "ledger_id": "CANDLE-OCAML-FLOAT-LITERAL-001",
  "reference": {
    "implementation": "OCaml",
    "version": "4.14.1",
    "bit_observation": "Int64.bits_of_float printed as an unsigned 64-bit integer"
  },
  "supported_subset": "the ten exact positive_cases spellings below, covering pinned decimal points, exponents, separator underscores, signed zero, and a subnormal; broader non-ERANGE decimal support remains implementation intent pending corpus execution evidence",
  "out_of_scope": [
    {
      "syntax": "hexadecimal floating-point literals such as 0x1.0p0",
      "reason": "the retained CakeML decimal scanner does not recognize them and no such literal occurs in the audited Great 100 source slice"
    }
  ],
  "candle_excluded_cases": [
    {
      "id": "hexadecimal_float",
      "literal": "0x1.0p0"
    }
  ],
  "runtime_divergence_cases": [
    {
      "id": "overflow_to_infinity",
      "literal": "1e309",
      "ocaml_expected_word64_decimal": "9218868437227405312",
      "candle_expected": "Option.valOf raises because Double.fromString maps ERANGE to None"
    },
    {
      "id": "underflow_to_zero",
      "literal": "1e-4000",
      "ocaml_expected_word64_decimal": "0",
      "candle_expected": "Option.valOf raises because Double.fromString maps ERANGE to None"
    }
  ],
  "positive_cases": [
